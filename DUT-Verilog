////////////////////////// synchronizer/////////////////////////////////////
module ff_sync #(parameter ADDBITS = 4) (input clk, 
                                         input rst, 
                                         input [ADDBITS-1:0] din,
                                         output reg [ADDBITS-1:0] dout);
  
  reg [ADDBITS-1:0] q; // internal design object
  
  always @ (posedge clk or negedge rst) begin 
    if (!rst)
      begin {dout, q} <= 0 end
    else 
      begin {dout, q} <= {q, din} end
  end
  
endmodule

///////////////////////////////////////// memory ////////////////////////////

module fifo_mem #(parameter ADDBITS = 4, DATA = 8) (input wclk,
                                                    input wclk_en, 
                                                    input wfull, 
                                                    input [DATA-1:0] wdata,
                                                    input [ADDBITS-1:0] radd, 
                                                    input [ADDBITS-1:0] wadd,
                                                    output [DATA-1:0] rdata);
  localparam DEPTH = 1 << ADDBITS;
  reg [DATA-1:0] mem [0:DEPTH-1];
  
  assign rdata = mem[radd];
  
  always @ (posedge wclk) begin 
    if (wclk_en && !wfull) mem[wadd] <= wdata;
  end
  
endmodule
      
/////////////////////////////// read pointer handler//////////////////////

module rptr_handler #(parameter ADDBITS = 4) (input rclk,
                                             input rrst,
                                             input rinc,
                                             input [ADDBITS:0] wptr_s_rclk,
                                             output [ADDBITS-1:0] radd,
                                             output reg [ADDBITS:0]rptr, 
                                             output reg rempty);
                                               
                                             
  // internal design objects
  reg [ADDBITS:0] rbin;
  wire [ADDBITS:0] rbin_next, rgray_next;
  wire rempty_val;
  
  always @ (posedge rclk or negedge rrst) begin
    if (!rrst) begin
      {rbin, rptr} <= 0;
      rempty <= 1'b1;
    end
    else begin
      {rbin, rptr} <= {rbin_next, rgray_next};
      rempty <= rempty_val;
    end
  end
  
  assign radd = rbin[ADDBITS-1:0];
  assign rbin_next = rbin + (rinc & ~rempty);
  assign rgray_next = (rbin_next>>)^rbin_next;
  assign rempty_val = (wptr_s_rclk == rgray_next);
  
endmodule

//////////////////////////////write pointer handler////////////////////////

module wptr_handler #(parameter ADDBITS = 4) (input wclk,
                                             input wrst,
                                             input winc,
                                              input [ADDBITS:0] rptr_s_wclk,
                                              output [ADDBITS-1:0] wadd,
                                              output reg [ADDBITS:0] wptr, 
                                              output reg wfull);
  // internal design objects
  reg [ADDBITS:0] wbin;
  wire [ADDBITS:0] wbin_next, wgray_next;
  wire wfull_val;
  
  always @ (posedge wclk or negedge wrst) begin
    if (!wrst) begin
      {wbin, wptr} <= 0;
      wfull <= 1'b0;
    end
    else begin
      {wbin, wptr} <= {wbin_next, wgray_next};
      wfull <= wfull_val;
    end
  end
  
  assign wadd = [ADDBITS-1:0] wbin;
  assign wbin_next = wbin + (winc & ~wfull);
  assign wgray_next = (wbin_next>>)^wbin_next;
  assign wfull_val = (wgray_next == {~rptr_s_wclk[ADDBITS:ADDBITS-1], rptr_s_wclk[ADDBITS-2:0]});
  
endmodule

///////////////////////////////top module/////////////////////////////////

module fifo_top #(parameters ADDBITS = 4, DATA = 8) (input wclk,
                                                    input rclk,
                                                    input wrst,
                                                    input rrst,
                                                    input winc,
                                                    input rinc,
                                                    input [ADDBITS-1:0] wdata,
                                                    output [ADDBITS-1:0] rdata,
                                                    output wfull,
                                                    output rempty);
  
  wire [ADDBITS-1:0] wadd, radd;
  wire [ADDBITS:0] wptr, rptr, wptr_s_rclk, rptr_s_wclk;
  
  ff_sync #(ADDBITS+1) w2r_sync (.din(wptr), .clk(rclk), .rst(rrst), .dout(wptr_s_rclk));
  ff_sync #(ADDBITS+1) r2w_sync (.din(rptr), .clk(wclk), .rst(wrst), .dout(rptr_s_wclk));
  
  fifo_mem #(.ADDBITS(ADDBITS), .DATA(DATA)) fifomem (.wdata(wdata), .rdata(rdata), .wclk_en(winc),
                                                      .wadd(wadd), .radd(radd), .wclk(wclk), 
                                                      .wfull(wfull));
  
  rptr_handler #(ADDBITS) (.rrst(rrst), .rclk(rclk), .rinc(rinc), .wptr_s_rclk(wptr_s_rclk),
                           .radd(radd), .rptr(rptr), .rempty(rempty));
  
  wptr_handler #(ADDBITS) (.wrst(wrst), .wclk(wclk), .winc(winc), .rptr_s_wclk(rptr_s_wclk),
                           .wadd(wadd), .wptr(wptr), .wfull(wfull));
  
endmodule
