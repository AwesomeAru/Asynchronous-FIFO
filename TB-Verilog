`timescale 1ns/1ps

module asyn_fifo_tb();
  
parameter DATA = 8;
parameter ADDBITS = 4;
parameter DEPTH = 1 << ADDBITS; 
  
wire [DATA-1:0] rdata;
wire wfull;
wire rempty;
reg [DATA-1:0] wdata;
reg winc, wclk, wrst;
reg rinc, rclk, rrst;
  
 // Instantiate your fifo module
  fifo_top #(ADDBITS, DATA) fifo_inst(
    .wclk(wclk),
    .wrst(wrst),
    .rclk(rclk),
    .rrst(rrst),
    .winc(winc),
    .rinc(rinc),
    .wdata(wdata),
    .rdata(rdata),
    .wfull(wfull),
    .rempty(rempty)
  );
  
 // Clock generation
  always #10 wclk = ~wclk;
  always #35 rclk = ~rclk;
  always #500 rrst = ~rrst;
  //always #600 winc = ~winc;
  //always #600 rinc = ~rinc;
  
  
 initial begin
    wclk = 1'b0;
    wrst = 1'b1;
    winc = 1'b0;
    wdata = 0;
   
 // Wait for some cycles before releasing reset
   repeat (15) begin
     @(posedge wclk ) begin 
         if (!wfull)
           wdata = $random;
       
     end
     #50;
   end
 end
 

initial begin
  rclk = 1'b0;
  rrst = 1'b1;
  rinc = 1'b0; 
 #300;   
 // Wait for some cycles before releasing reset
  repeat (20) begin 
    @(posedge rclk) begin
        if (!rempty) begin
          if (rdata !== wdata) begin
            $error("Time = %0t: Comparison Failed: expected wr_data = %h, rd_data = %h", $time, wdata, rdata);
          end
          else begin
            $display("Time = %0t: Comparison Passed: wr_data = %h and rd_data = %h", $time, wdata, rdata);
          end
        end
      
    end
   #50;
  end
  $finish;
 end
      
  initial begin 
    $dumpfile("dump.vcd"); 
    $dumpvars;
  end

endmodule
